<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only the network. Reading what's playing comes from the notification-access toggle the
         listener grants once (Settings), never from any other permission. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Jingle"
        android:icon="@android:drawable/ic_media_play"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PlayListener"
            android:exported="true"
            android:label="Jingle: share what you play"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
