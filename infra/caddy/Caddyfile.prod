# Pilot server edge with automatic HTTPS (docs/runbooks/deploy-pilot.md).
{
	admin off
	email {$JINGLE_ACME_EMAIL}
}

{$JINGLE_DOMAIN} {
	encode gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	@djadmin path /admin /admin/*
	respond @djadmin 404
	@internal path /internal/*
	respond @internal 404
	@api path /api/*
	request_body @api {
		max_size 60MB
	}
	reverse_proxy @api core-api:8000 {
		header_up X-Request-ID {http.request.uuid}
	}
	@ingest path /ingest/*
	request_body @ingest {
		max_size 2MB
	}
	reverse_proxy @ingest ingest-ml:8001 {
		header_up X-Request-ID {http.request.uuid}
	}
	@rt path /rt/*
	reverse_proxy @rt realtime:4000
	reverse_proxy web:3000
}
