# Single-origin edge for local and pilot (CONTRACTS.md §1).
{
	auto_https off
	admin off
}

:8080 {
	encode gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	@api path /api/* /admin/*
	request_body @api {
		max_size 60MB
	}
	reverse_proxy @api core-api:8000 {
		header_up X-Request-ID {http.request.uuid}
	}
	@ingest path /ingest/*
	request_body @ingest {
		max_size 2MB
	}
	reverse_proxy @ingest ingest-ml:8001 {
		header_up X-Request-ID {http.request.uuid}
	}
	@rt path /rt/*
	reverse_proxy @rt realtime:4000
	@internal path /internal/*
	respond @internal 404
	reverse_proxy web:3000
}
