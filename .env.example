# Jingle — copy to .env and fill in. Never commit .env.
# Every value below works as-is for local demo mode (JINGLE_DEMO=1).
# Values marked [HUMAN] need Shlok — see docs/office/HUMAN_ACTIONS.md.

# ---- Mode -------------------------------------------------------------------
JINGLE_ENV=local
# 1 = seeded world of ~12 fake friends with simulated Live plays; no keys needed
JINGLE_DEMO=1
# 127.0.0.1 (not localhost) so Spotify's loopback redirect shares Jingle's origin (ADR-0016)
PUBLIC_BASE_URL=http://127.0.0.1:8080
# Sign-ups per IP per minute; production must use 5/m (NFR-SEC-04). Looser locally for E2E runs.
AUTH_REGISTER_RATE=60/m
AUTH_LOGIN_RATE=120/m
AUTH_REFRESH_RATE=600/m
# Persistent DB connections (seconds). 0 measured best on the pilot (docs/runbooks/performance.md)
DB_CONN_MAX_AGE=0

# ---- Secrets (local defaults are NOT for production; generate new ones) ----
# python -c "import secrets;print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=dev-only-change-me-django-secret-key-0000000000000000
JWT_SIGNING_KEY=dev-only-change-me-jwt-signing-key-00000000000000000000
SERVICE_TOKEN=dev-only-change-me-service-token-0000000000000
# 32 random bytes, base64 — key-encryption key for AES-256-GCM token envelopes (local stand-in for KMS)
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
TOKEN_KEK_B64=ZGV2LW9ubHktMzItYnl0ZS1rZXktZm9yLWxvY2FsISE=
TOKEN_KEK_ID=local-1

# ---- Datastores -------------------------------------------------------------
POSTGRES_DB=jingle
POSTGRES_USER=jingle
POSTGRES_PASSWORD=jingle-local
DATABASE_URL=postgres://jingle:jingle-local@postgres:5432/jingle
MONGO_URL=mongodb://mongo:27017/jingle
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
QDRANT_URL=http://qdrant:6333

# ---- Internal service URLs --------------------------------------------------
CORE_API_INTERNAL_URL=http://core-api:8000
INGEST_INTERNAL_URL=http://ingest-ml:8001
REALTIME_INTERNAL_URL=http://realtime:4000

# ---- Google sign-in (Jingle accounts) [HUMAN] -------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Spotify direct route (max 5 allowlisted users) [HUMAN] -----------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/v1/sources/spotify/callback
# comma-separated JINGLE account emails of the ≤5 testers (their Spotify emails go in the Spotify dashboard)
SPOTIFY_ALLOWLIST=

# ---- Last.fm bridge [HUMAN] --------------------------------------------------
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# ---- ListenBrainz (users bring their own token; nothing needed here) --------
LISTENBRAINZ_API_URL=https://api.listenbrainz.org

# ---- MusicBrainz / Cover Art Archive (no key; identify ourselves) -----------
# MusicBrainz requires a real contact (email or URL) in the User-Agent; empty = lookups disabled [HUMAN]
MUSICBRAINZ_CONTACT=
# Optional override: true/false. Unset = on when a contact is set, off in demo mode and tests.
MUSICBRAINZ_ENABLED=
MUSICBRAINZ_API_URL=https://musicbrainz.org/ws/2

# ---- Push endpoint (/ingest/1/*) --------------------------------------------
# Per-user budget in listens per minute (a request costs its listen count)
PUSH_RATE_LIMIT_PER_MINUTE=60
# Budget for failed-auth requests per client IP per minute
PUSH_AUTH_FAIL_LIMIT_PER_MINUTE=30

# ---- Flagged-off integrations (need company approvals; leave empty) ---------
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_PATH=
AMAZON_MUSIC_CLIENT_ID=
AMAZON_MUSIC_CLIENT_SECRET=
AMAZON_MUSIC_API_KEY=
GOOGLE_DATAPORTABILITY_CLIENT_ID=
GOOGLE_DATAPORTABILITY_CLIENT_SECRET=

# ---- Web push (VAPID; generate locally, no approval needed) -----------------
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@jingle.local

# ---- Email (console backend locally) ----------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Jingle <no-reply@jingle.local>
